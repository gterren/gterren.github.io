{% comment %}
  Renders a repository card from metadata collected at build time by
  _plugins/github-repo-metadata.rb (cached in .github-repos.json), so the page
  does not depend on the third-party github-readme-stats image service.

  Optional per-repository description overrides can be set in
  _data/repositories.yml under `repo_descriptions:` using the "owner/name" key.
{% endcomment %}

{% assign repo_url = include.repository | split: '/' %}
{% assign meta = site.data.github_repo_metadata[include.repository] %}

{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

{% if show_owner %}
  {% assign repo_title = include.repository %}
{% else %}
  {% assign repo_title = repo_url[1] %}
{% endif %}

{% assign repo_description = site.data.repositories.repo_descriptions[include.repository] %}
{% if repo_description == nil or repo_description == '' %}
  {% assign repo_description = meta.description %}
{% endif %}

{% if site.data.repositories.repo_description_lines_max %}
  {% assign max_lines = site.data.repositories.repo_description_lines_max %}
{% else %}
  {% assign max_lines = 2 %}
{% endif %}

{% assign lang_color = '#8b949e' %}
{% case meta.language %}
  {% when 'Python' %}
    {% assign lang_color = '#3572a5' %}
  {% when 'Jupyter Notebook' %}
    {% assign lang_color = '#da5b0b' %}
  {% when 'R' %}
    {% assign lang_color = '#198ce7' %}
  {% when 'MATLAB' %}
    {% assign lang_color = '#e16737' %}
  {% when 'C++' %}
    {% assign lang_color = '#f34b7d' %}
  {% when 'C' %}
    {% assign lang_color = '#555555' %}
  {% when 'Julia' %}
    {% assign lang_color = '#a270ba' %}
  {% when 'TeX' %}
    {% assign lang_color = '#3d6117' %}
  {% when 'Shell' %}
    {% assign lang_color = '#89e051' %}
  {% when 'HTML' %}
    {% assign lang_color = '#e34c26' %}
  {% when 'JavaScript' %}
    {% assign lang_color = '#f1e05a' %}
{% endcase %}

{% assign repo_link = meta.html_url %}
{% if repo_link == nil or repo_link == '' %}
  {% assign repo_link = 'https://github.com/' | append: include.repository %}
{% endif %}

{% assign repo_stars = meta.stars | default: 0 %}
{% assign repo_forks = meta.forks | default: 0 %}

<div class="repo p-2">
  <a class="repo-card" href="{{ repo_link }}" title="{{ include.repository }} on GitHub">
    <span class="repo-card-title">
      <i class="fa-brands fa-github" aria-hidden="true"></i>
      <span class="repo-card-name">{{ repo_title }}</span>
      {% if meta.archived %}<span class="repo-card-archived">archived</span>{% endif %}
    </span>

    {% if repo_description and repo_description != '' %}
      <span class="repo-card-description" style="--repo-desc-lines: {{ max_lines }};">{{ repo_description }}</span>
    {% endif %}

    <span class="repo-card-meta">
      {% if meta.language %}
        <span class="repo-card-stat">
          <span class="repo-card-lang-dot" style="background-color: {{ lang_color }};" aria-hidden="true"></span>
          {{ meta.language }}
        </span>
      {% endif %}
      {% if repo_stars > 0 %}
        <span class="repo-card-stat" title="Stars">
          <i class="fa-solid fa-star" aria-hidden="true"></i> {{ repo_stars }}
        </span>
      {% endif %}
      {% if repo_forks > 0 %}
        <span class="repo-card-stat" title="Forks">
          <i class="fa-solid fa-code-fork" aria-hidden="true"></i> {{ repo_forks }}
        </span>
      {% endif %}
    </span>
  </a>
</div>
